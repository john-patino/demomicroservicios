{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "users-health-route": {
        "ClusterId": "users-cluster",
        "CorsPolicy": "AllowFrontend",
        "Match": {
          "Path": "/gateway/users/health"
        },
        "Transforms": [
          { "PathPattern": "/health" }
        ]
      },
      "products-health-route": {
        "ClusterId": "products-cluster",
        "CorsPolicy": "AllowFrontend",
        "Match": {
          "Path": "/gateway/products/health"
        },
        "Transforms": [
          { "PathPattern": "/health" }
        ]
      },
      "orders-health-route": {
        "ClusterId": "orders-cluster",
        "CorsPolicy": "AllowFrontend",
        "Match": {
          "Path": "/gateway/orders/health"
        },
        "Transforms": [
          { "PathPattern": "/health" }
        ]
      },
      "users-route": {
        "ClusterId": "users-cluster",
        "CorsPolicy": "AllowFrontend",
        "Match": {
          "Path": "/gateway/users/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/users/{**catch-all}" }
        ]
      },
      "products-route": {
        "ClusterId": "products-cluster",
        "CorsPolicy": "AllowFrontend",
        "Match": {
          "Path": "/gateway/products/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/products/{**catch-all}" }
        ]
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "CorsPolicy": "AllowFrontend",
        "Match": {
          "Path": "/gateway/orders/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/orders/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "products-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003"
          }
        }
      }
    }
  },
  "SeqServerUrl": "http://localhost:5341"
}
